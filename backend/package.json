{
  "name": "icar-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST del sistema comercial ICAR",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/principal.js",
    "migration:run": "node ./node_modules/typeorm/cli.js migration:run -d dist/base-datos/data-source.js",
    "migration:revert": "node ./node_modules/typeorm/cli.js migration:revert -d dist/base-datos/data-source.js",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:acceptance": "node scripts/iteration-one.acceptance.mjs",
    "test:acceptance:iteration2": "node scripts/iteration-two.acceptance.mjs",
    "test:acceptance:iteration3": "node scripts/iteration-three.acceptance.mjs",
    "test:acceptance:iteration4": "node scripts/iteration-four.acceptance.mjs",
    "test:acceptance:iteration5": "node scripts/iteration-five.acceptance.mjs",
    "test:acceptance:iteration6": "node scripts/iteration-six.acceptance.mjs",
    "test:acceptance:production-flow": "node scripts/production-plant.acceptance.mjs",
    "test:acceptance:production-tracking": "node scripts/production-tracking-scope.acceptance.mjs",
    "test:acceptance:stock-requests": "node scripts/stock-replenishment.acceptance.mjs",
    "test:acceptance:workflow": "node scripts/order-workflow.acceptance.mjs",
    "test:acceptance:isolated": "node scripts/orders-isolated.acceptance.mjs",
    "verificar:tamano": "node ../scripts/verificar-tamano-archivos.mjs",
    "calidad": "npm run verificar:tamano && npm run build && npm run typecheck && npm test && npm run test:seed:admin",
    "typecheck": "tsc --noEmit --incremental false --rootDir . -p tsconfig.json",
    "seed:admin": "node scripts/recover-admin.mjs",
    "test:seed:admin": "node --test scripts/recover-admin.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/jwt": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/typeorm": "12.0.1",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.2.3",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.17.2",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@swc/core": "1.16.1",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/pdfkit": "^0.17.4",
    "@vitest/coverage-v8": "4.1.11",
    "prettier": "3.7.4",
    "typescript": "6.0.3",
    "unplugin-swc": "1.5.11",
    "vitest": "4.1.11"
  }
}
