# Puerto público del sistema (Nginx)
APP_PORT=8080

# PostgreSQL
POSTGRES_DB=icar_comercial
POSTGRES_USER=icar_app
POSTGRES_PASSWORD=cambiar-en-desarrollo

# Backend
NODE_ENV=development
DATABASE_SSL=false
CORS_ORIGIN=http://localhost:8080
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
PASSWORD_RESET_TTL_SECONDS=1800
INITIAL_ADMIN_EMAIL=admin@icar.local
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Cambiar123!

# Seguimiento público y mensajería de la quinta iteración
PUBLIC_APP_URL=http://localhost:8080
LIMITE_API_URL=https://apiqr.limiteflix.com/api/v1/messages/send
# Clave opcional dedicada al cifrado del token configurado desde la interfaz.
# Si queda vacía, el sistema deriva la clave desde JWT_SECRET.
CHANNEL_CREDENTIALS_KEY=
# El secreto del webhook sí permanece exclusivamente en el entorno.
WHATSAPP_WEBHOOK_TOKEN=
NOTIFICATION_WORKER_POLL_MS=5000
PUBLIC_TRACKING_RATE_LIMIT=30
PUBLIC_TRACKING_RATE_WINDOW_MS=60000
